# rascal.env file
# ---------------
#
# This file is read by rascalint.so/.dll and contains the options required to
# launch the required simulator, control the appearance and behaviour of that
# simulator, and control RASCAL's operation.
#

Simulator = userdefined

# The simulator command line invokes the simulation model. Only ONE line should be enabled.

Command = /vlsi/h6/users/rzehorai/repo/h6_arc/work_area/h6_arc/h6/h6_qman_arc/h6_qman_arc/build/verilator/xcam_integrated -no_exit_on_halt -pipemon_level=2 -pipemon_file=/users/home/rughreja/gaudi2/engines-arc/pipe.log
#Command = /vlsi/h6/users/rzehorai/repo/h6_arc/work_area/h6_arc/h6/h6_qman_arc/h6_qman_arc/build/verilator/xcam_sc -no_exit_on_halt  
#Command = /vlsi/h6/users/rzehorai/repo/h6_arc/work_area/h6_arc/h6/h6_qman_arc/h6_qman_arc/build/verilator/xcam_tlm -no_exit_on_halt  

# =========================================
# Simulator:                 
#   Which HDL simulator to use. Set to 'userdefined' for xCAM simulations.
# =========================================
# Command:                       
#   Command line to run the xCAM model.
#
# When using the xCAM model with the debugger, 
# you can pass the following options on the command line in this file:
#
# -no_exit_on_halt               
#    Keep the simulation running when the xCAM model halts. 
#    Should only be used with a debugger.
# -pipemon_level=<number>        
#    Specify the level of processor pipeline tracing:
#      0 = off.
#      1 = display counters in debugger (default).
#      2 = display counters in debugger and write 
#          a pipeline transcript file.
# See below for dynamically changing pipemon behavior during a run.
# -pipemon_file=<filename>       
#    Specify the file in which the pipeline transcript is stored 
#    when pipemon_level=2.
# -hide_start_stop               
#    Don't display the start/stop information 
#    each time the xCAM model (core) starts/stops.
# -hide_cycle_count              
#    Don't display the cycle count information 
#    while the xCAM model (core) runs.
# -hide_bvci_stats               
#    Don't display the automatic xCAM BVCI statistics 
#    each time the xCAM model (core) stops.
# =========================================
# Other options:
#   prop=wait_time=NNNN
#     Specify that RASCAL should wait up to NNNN cycles (default:4000)
#     for a transaction to complete.  If the transaction exceeds that,
#     RASCAL halts the RTL simulation.
#   prop=batch_mode=1
#     If the wait time is exceeded, RASCAL will no longer run the simulator.
#     This increases the chances that a debugger script using RASCAL will terminate.
#   prop=trace=1
#     Trace transactions in the RASCAL server.
#   prop=require_ram_map=1
#     If the simulation requires a backdoor memory model and file rascal_ram_map.txt
#     is missing, refuse to run the simulator.  (Requires RASCAL server 3.77.)
prop=require_ram_map=1
prop=wait_time=1200000

# Dynamically changing pipemon behavior during a run.
# ---------------------------------------------------
# You can turn pipemon on and off with the debugger in several ways.
#
# The simplest way is to turn off or on the trace at the command line:
#
# 	mdb> off=ras_pipemon_trace
# 	mdb> on=ras_pipemon_trace
#
# You could start with -pipemon_level=2, immediately turn it off,
# and then turn it back on when you need it.
# These two commands only work if you have initially enabled pipemon
# with -pipemon_level.
# 
# The next two ways are more complicated.
# In each, you assign a value that pipemon uses to direct its behavior.
#
# The value has the following bits:
#     bit 0: 1 = enable statistics gathering (e.g. stall counting)
#     bit 1: 1 = suppress trace
#     bit 2: (ignored; reserved)
#     bit 3: 1 = if trace is not suppressed, 
#                suppress tracing of instructions executed to 
#	 	 respond to debugger requests
# 
# The first way:
#	mdb> prop ras_pipemon_enabled=value
# where value is an integer -- e.g. 3 or 0x9.  This value holds
# until you assign a different value, or you "cancel" this by
# writing a non-integer value:
#	mdb> prop ras_pipemon_enabled=cancel
# 
# The second way is a special register in xcam.  
# You write this register with the following debugger command:
#     eval $put_bank_reg(22, 0x1020, value)
# Thus,
#     eval $put_bank_reg(22, 0x1020, 1)
# turns on tracing as it does not suppress the trace.
#     eval $put_bank_reg(22, 0x1020, 3)
# turns off tracing but retains statistics gathering.
# 
# "value" is exactly the signal that pipemon reads at each cycle
# in its Verilog interface.
# You can also read back the value of the signal with
#     eval $bank_reg(22, 0x1020)
# and so could even assign it to a debugger temporary.

# The -pipemon_level command option described above
# computes the appropriate value for this signal.  
# If you assign it, you are overriding pipemon_level entirely
# (except for its initial function of setting up the pipemon.log file).
# If you do not start with -pipemon_level=2, it is not possible
# to later cause the log to go to a file.

# You can also restrict the size of a pipemon file with
# 	set PIPEMON_FILE_SIZE=NN
# where NN is in bytes.  When the file gets close to NN,
# it will be closed and a subsequent file opened; the name
# of that file is in the last line of the closed file.
