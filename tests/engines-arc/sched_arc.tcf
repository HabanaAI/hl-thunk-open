  <configuration name="alb_mss_fab_system_memmap.s" filename="alb_mss_fab_system_memmap.s">
    <string><![CDATA[
// System memory map

.equ MSS_CLKCTRL_0_BASE, 0xc0000000
.equ MSS_CLKCTRL_0_SIZE, 0x1000
.equ SCCM_AXI_0_BASE, 0xa0000000
.equ SCCM_AXI_0_SIZE, 0x1000000
.equ SCCM_AXI_1_BASE, 0xa1000000
.equ SCCM_AXI_1_SIZE, 0x1000000
.equ SCCM_AXI_2_BASE, 0xa2000000
.equ SCCM_AXI_2_SIZE, 0x1000000
.equ MSS_PERFCTRL_0_BASE, 0xc0002000
.equ MSS_PERFCTRL_0_SIZE, 0x2000
.equ MSS_MEM_0_BASE, 0x0000
.equ MSS_MEM_0_SIZE, 0x80000000
.equ MSS_MEM_1_BASE, 0xc0000000
.equ MSS_MEM_1_SIZE, 0x40000000

// when default slave is not set, there may be unallocated memory space in the system
// following statements report the total unallocated region and its corresponding
// start address and end address in system memory map
// NOTE: the info is credit for 32-bit space, may inaccurate in 40-bit memory space
//       due to limitation of VPP expression to handle more than 2^32 values


.equ UNALLOC_SPACE_NUM,       5
.equ UNALLOC_SPACE_0_START_ADDR,  0x80000000  //2147483648
.equ UNALLOC_SPACE_0_END_ADDR,    0x9fffffff  //2684354559
.equ UNALLOC_SPACE_1_START_ADDR,  0xa3000000  //2734686208
.equ UNALLOC_SPACE_1_END_ADDR,    0xbfffffff  //3221225471
.equ UNALLOC_SPACE_2_START_ADDR,  0xc0001000  //3221229568
.equ UNALLOC_SPACE_2_END_ADDR,    0xbfffffff  //3221225471
.equ UNALLOC_SPACE_3_START_ADDR,  0x100000000  //4294967296
.equ UNALLOC_SPACE_3_END_ADDR,    0xc0001fff  //3221233663
.equ UNALLOC_SPACE_4_START_ADDR,  0xc0004000  //3221241856
.equ UNALLOC_SPACE_4_END_ADDR,    0xffffffff  //4294967295

// CCM system address with the specific name
.equ ICCM0_SYS_BASE, 0xa0000000
.equ ICCM0_SYS_SIZE, 0x1000000
.equ ICCM1_SYS_BASE, 0xa1000000
.equ ICCM1_SYS_SIZE, 0x1000000
.equ DCCM_SYS_BASE, 0xa2000000
.equ DCCM_SYS_SIZE, 0x1000000

.equ HAS_DEFAULT_SLAVE, 0
]]></string>
